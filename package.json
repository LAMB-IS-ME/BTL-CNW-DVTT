{
  "name": "online-examination-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @exam/api\" \"npm run dev -w @exam/web\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "npm run build -w @exam/shared && npm run build -w @exam/api && npm run build -w @exam/web",
    "db:generate": "npm run db:generate -w @exam/api",
    "db:migrate": "npm run db:migrate -w @exam/api",
    "db:seed": "npm run db:seed -w @exam/api",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests *.ts *.js *.json .github",
    "test:deployment": "node tests/deployment/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "esbuild": "^0.28.2"
  }
}
