# npm workspace commands load this file from apps/api. Never commit apps/api/.env.
# Required: DATABASE_URL and a random SESSION_SECRET of at least 32 characters.
# See docs/deployment/ENVIRONMENT_MATRIX.md for production and test settings.
NODE_ENV=development
PORT=3000
DATABASE_URL=
# CLI migration connection only; runtime, sessions and seed use DATABASE_URL.
DIRECT_URL=
SESSION_SECRET=
SESSION_COOKIE_NAME=online_exam_sid
SESSION_MAX_AGE_MS=28800000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=question-assets
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
# Keep false. Explicit permission alone does not enforce a non-default demo password.
ALLOW_PRODUCTION_SEED=false
# Optional password for first-time development seed only.
DEMO_PASSWORD=
